# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# Sanity is public-read. Do not put a Sanity token in NEXT_PUBLIC_* — it ships to the browser.
# Editor token for chat writes + /api/videos-sync only (server-side). Mark Sensitive on Vercel.
SANITY_API_TOKEN=your_sanity_write_token_here
# Vercel sends this as Authorization: Bearer … on cron. Random string is fine. Mark Sensitive.
CRON_SECRET=your_cron_secret_here

# Mapbox public pk. token (ships to the browser).
# Restrict URLs in the Mapbox dashboard: https://drewdella.com + http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Sanity webhook for on-demand revalidation. Send as header x-sanity-secret.
# Random string. Mark Sensitive on Vercel.
SANITY_REVALIDATE_SECRET=your_revalidate_secret_here

# Contact form (Hangouts → Email Drew). All three are required or the form returns 503.
# RESEND_API_KEY: Resend API key. Mark Sensitive.
# CONTACT_FROM_EMAIL: a verified Resend sender, e.g. Drew Della <hello@drewdella.com>
# CONTACT_TO_EMAIL: where messages should land.
RESEND_API_KEY=re_your_resend_key_here
CONTACT_FROM_EMAIL=Drew Della <hello@drewdella.com>
CONTACT_TO_EMAIL=you@example.com
